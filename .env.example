# Server Configuration
PORT=4000
NODE_ENV=production

# Redis Configuration
REDIS_URL=redis://default:password@host:port

# MongoDB Configuration (for analytics)
MONGO_URI=mongodb+srv://username:password@cluster/db

# Storage Configuration
STORAGE_PATH=/tmp/video-cache
MAX_CACHE_SIZE_GB=10

# Rate Limiting
RATE_LIMIT_DOWNLOAD_MAX=10
RATE_LIMIT_DOWNLOAD_WINDOW=3600

# Analytics
ANALYTICS_BATCH_SIZE=10
ANALYTICS_FLUSH_INTERVAL=300000

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://owais-task.netlify.app
